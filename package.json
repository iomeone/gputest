    "webpack": "^5.10.1",
    "webpack-cli": "^4.2.0",
    "webpack-dev-server": "^3.11.0"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack serve",
    "test": "jest --watch",
    "lint": "eslint src --ext ts",
    "coverage": "jest",
    "types": "tsc --noEmit",
    "types:watch": "yarn run types -- --watch",
    "build": "yarn run build && yarn run build:bundle",
    "build:types": "tsc --emitDeclarationOnly",
    "build:bundle": "webpack",
    "build:js": "babel src --out-dir lib --extensions \".ts,.tsx\" --source-maps inline"
  },
  "dependencies": {
    "yarn": "^1.22.22"
  },
  "jest": {
    "preset": "ts-jest",
    "transform": {
      "\\.jsx?$": "babel-jest",
      "\\.glsl$": "<rootDir>/test/fileTransformer.mjs"
    },
    "modulePaths": [
      "<rootDir>/src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/build"
    ],
    "setupFiles": [
      "./test/setup.ts"
    ]
  }
}